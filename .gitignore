# Abhängigkeiten
node_modules/
.pnpm-store/

# Build-Artefakte
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Umgebung / Secrets – niemals ins Repository (Pflichtenheft §12.1)
.env
# Und jede Kopie davon: `.env.sicherung`, `.env.vor-dem-umbau`, `.env.local`.
# Solche Dateien entstehen beim Herumprobieren in Minuten und tragen saemtliche
# Geheimnisse der Instanz. Bisher deckte die Liste nur `.env` selbst - eine
# Sicherungskopie stand sofort als `??` im `git status`, und dieses Repository
# ist oeffentlich (Fundpunkt 248). Deckt `.env.local` und `.env.<name>.local`
# mit ab, die vorher einzeln dastanden.
.env.*
# Die Vorlage ist der eine gewollte Fall: Sie enthaelt keine Werte, nur Namen
# und Erklaerungen (Pflichtenheft §12.1), und gehoert verfolgt.
!.env.example
*.key
*.pem
wireguard/

# Betriebsdaten der Auscheckung unter /opt/palantir (Audit W2-23,
# infra-images-17). Die Produktionsauscheckung ist ein normales Git-Repo -
# deploy.sh arbeitet darin. Ohne diese Zeilen zeigt `git status` dort drei
# untracked Verzeichnisse, und ein `git add -A && git push` nach einem Hotfix
# veroeffentlicht sie im oeffentlichen Repository: acme.json enthaelt den
# ACME-Kontoschluessel und die privaten Schluessel aller Zertifikate,
# postgres-data/ das Datenverzeichnis der Datenbank und data/panel-backups die
# vollstaendigen Abzuege - samt aller Geheimnisse aus der Datenbank.
# Angelegt werden sie von deploy/vps/docker-compose.yml.
/deploy/vps/letsencrypt/
/deploy/vps/postgres-data/
/data/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test-Ausgaben
coverage/

# graphify Wissensgraph-Ausgabe (lokales Artefakt, große graph.json – nicht committen)
graphify-out/

# Projektdokumente und Arbeitsunterlagen - bleiben lokal, nicht im Repository.
# Entscheidung des Betreibers beim Wechsel auf ein oeffentliches Repository:
# oeffentlich ist der Code, alles Weitere liegt nur auf den Rechnern des Teams.
# Im Repo-Root ist README.md die einzige Markdown-Datei; jede andere dort
# (Lastenheft, Pflichtenheft, Arbeitsstand, Einrichtungsanleitung, Berichte)
# ist ein Arbeitsdokument. Das Muster deckt auch neue Dokumente ab, ohne dass
# jemand die Liste pflegen muss.
/*.md
!/README.md
docs/
deploy/gamenode/wireguard-firewall.md

# Betriebsunterlagen aus Arbeitspaket HM-8. `geheimnisse.md` nennt keinen einzigen
# echten Wert, wohl aber fuer jedes Geheimnis Ablageort, lesenden Prozess und
# Rotationsfolge - also die Landkarte. `stolperpunkte.md` traegt Vorfaelle samt
# Pfaden und Fehlerbildern zusammen. Beides gehoert dem Betrieb, nicht der
# Oeffentlichkeit. Der Eintrag steht hier und nicht in `.git/info/exclude`,
# damit er auf jeder Auscheckung gilt (Fundpunkt 248: dort lag genau der
# Unterschied zwischen "faellt nicht auf" und "ist geschuetzt").
geheimnisse.md
stolperpunkte.md
VERGLEICH_HAFENMEISTER_13_09_2026.md

# Versteckte Verzeichnisse im Repo-Root sind Arbeitsablagen von Werkzeugen
# (Editor-Einstellungen, Worktrees paralleler Sitzungen, Startkonfiguration der
# Entwicklungsumgebung). Kein Teil des Repositories - .prettierignore fuehrt sie
# aus demselben Grund. Einzige Ausnahme ist .github mit den Workflows.
/.*/
!/.github/

# Ablage der Entwicklungsmaschine (u. a. Panel-Sicherungen aus PANEL_BACKUP_DIR)
.dev-data/

# Betriebsspuren der Auscheckung auf VPS und Gamenode: die Erfolgsmarke des
# zuletzt ausgerollten Standes und die Sperrdateien der Deploy-Skripte, wenn
# weder /run/palantir noch $XDG_RUNTIME_DIR zur Verfuegung stehen.
.deployed-sha
.deploy.lock
.update.lock
