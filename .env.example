# =============================================================================
# Palantir - zentrale Konfigurationsdatei (Vorlage)
# =============================================================================
# Pflichtenheft §12.1: Es gibt genau EINE .env im Repo-Root. Dieselbe Datei wird
# sowohl auf der VPS als auch auf dem Homeserver eingesetzt; jede Komponente
# liest nur die für sie relevanten Variablen.
#
# Erzeugen:             cp .env.example .env   (bzw. über scripts/setup.sh)
# Ablageort VPS:        /opt/palantir/.env
# Ablageort Homeserver: /opt/palantir/.env   (in der Gameserver-VM)
#
# SICHERHEITSAUFLAGE (Pflichtenheft §12.1):
#   chmod 600 .env  und Eigentümer auf den ausführenden Dienst-Nutzer setzen.
#   .env darf niemals ins Repository und nicht unverschlüsselt in automatische
#   System-Backups gelangen.
#
# Legende: [VPS] = wird auf der VPS gelesen, [HOME] = auf dem Homeserver,
#          [BEIDE] = auf beiden Maschinen.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Allgemein / Domain
# -----------------------------------------------------------------------------
# [BEIDE] development | production
NODE_ENV=production
# [BEIDE] fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# [VPS] Basis-Domain der Instanz. Gameserver-Subdomains werden hierunter
# angelegt (z. B. meinserver.<DOMAIN>). Der endgültige Name steht laut
# Pflichtenheft §19 noch aus - Platzhalter bis zur Festlegung.
PALANTIR_DOMAIN=example.tld
# [VPS] Öffentliche Adresse des Frontends (für OAuth-Redirects und Cookies).
PUBLIC_WEB_URL=https://example.tld
# [VPS] Öffentliche Adresse der Backend-API.
PUBLIC_API_URL=https://api.example.tld
# [VPS] Öffentliche IPv4 der VPS - Ziel der DNS-Einträge für Spiele ohne
# Hostname-Routing.
VPS_PUBLIC_IP=203.0.113.10


# -----------------------------------------------------------------------------
# 2. Netzwerk-Bindings der Dienste
# -----------------------------------------------------------------------------
# [VPS] Backend-API (Fastify)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
# [VPS] Frontend (Next.js)
FRONTEND_PORT=3000


# -----------------------------------------------------------------------------
# 3. Datenbank (PostgreSQL, laeuft auf der VPS)
# -----------------------------------------------------------------------------
# [VPS] Vollständige Verbindungs-URL, die von Drizzle ORM genutzt wird.
DATABASE_URL=postgresql://palantir:CHANGE_ME@127.0.0.1:5432/palantir
# [VPS] Einzelwerte für den Datenbank-Container in docker-compose.
POSTGRES_USER=palantir
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=palantir


# -----------------------------------------------------------------------------
# 4. Sicherheit / Tokens (Pflichtenheft §7)
# -----------------------------------------------------------------------------
# [VPS] Signaturschlüssel für die kurzlebigen Access-Token (JWT).
# Wird von scripts/setup.sh automatisch erzeugt - niemals von Hand raten.
JWT_SECRET=
# [VPS] Lebensdauer des Access-Tokens.
JWT_ACCESS_TOKEN_TTL=15m
# [VPS] Lebensdauer des opaken Refresh-Tokens (gehasht in der Session-Tabelle).
REFRESH_TOKEN_TTL=30d
# [VPS] Schlüssel für die CSRF-Token bei zustandsändernden Requests.
CSRF_SECRET=
# [VPS] Cookie-Domain für die httpOnly-Secure-Cookies.
# SameSite ist im Code fest auf "Lax" gesetzt (Pflichtenheft §7 - bewusst nicht
# "Strict", sonst bricht der OAuth-Rückkehr-Redirect).
COOKIE_DOMAIN=example.tld


# -----------------------------------------------------------------------------
# 5. OAuth / OpenID-Provider (Pflichtenheft §7 - minimale Scopes)
# -----------------------------------------------------------------------------
# Mindestens ein Provider muss konfiguriert sein (Pflichtfeld-Prüfung im Setup).
# Redirect-URIs müssen in der jeweiligen Entwickler-Konsole exakt so eingetragen
# werden - Details in SETUP.md.

# [VPS] Discord - https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.example.tld/auth/discord/callback

# [VPS] Twitch - https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://api.example.tld/auth/twitch/callback

# [VPS] Steam (OpenID 2.0, kein Client-Secret - nur ein Web-API-Key)
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
STEAM_RETURN_URL=https://api.example.tld/auth/steam/callback


# -----------------------------------------------------------------------------
# 6. ALTCHA (selbstgehostetes Proof-of-Work-CAPTCHA, Pflichtenheft §3)
# -----------------------------------------------------------------------------
# [VPS] HMAC-Schlüssel zur Signatur der ALTCHA-Challenges.
# Wird von scripts/setup.sh automatisch erzeugt.
ALTCHA_HMAC_KEY=
# [VPS] Schwierigkeitsgrad (obere Grenze der Zufallszahl). Höher = mehr
# Rechenaufwand für den Client.
ALTCHA_COMPLEXITY=100000
# [VPS] Gültigkeitsdauer einer Challenge in Sekunden.
ALTCHA_EXPIRY_SECONDS=300


# -----------------------------------------------------------------------------
# 7. WireGuard-Tunnel VPS <-> Homeserver (Pflichtenheft §2.1)
# -----------------------------------------------------------------------------
# Schlüsselpaare werden von scripts/setup.sh erzeugt. Der private Schlüssel
# einer Seite gehört ausschließlich auf die jeweilige Maschine.
# WireGuard-Konfigurationsdateien liegen unter:
#   VPS:        /etc/wireguard/wg0.conf
#   Homeserver: /etc/wireguard/wg0.conf  (in der Gameserver-VM)

# [VPS] Interne Tunnel-Adresse der VPS.
WIREGUARD_VPS_IP=10.10.0.1
# [HOME] Interne Tunnel-Adresse des Homeservers.
WIREGUARD_HOME_IP=10.10.0.2
# [VPS] Öffentlicher UDP-Port, auf dem WireGuard auf der VPS lauscht.
WIREGUARD_LISTEN_PORT=51820
# [VPS] Privater Schlüssel der VPS.
WIREGUARD_VPS_PRIVATE_KEY=
# [BEIDE] Öffentlicher Schlüssel der VPS (auf dem Homeserver als Peer nötig).
WIREGUARD_VPS_PUBLIC_KEY=
# [HOME] Privater Schlüssel des Homeservers.
WIREGUARD_HOME_PRIVATE_KEY=
# [BEIDE] Öffentlicher Schlüssel des Homeservers (auf der VPS als Peer nötig).
WIREGUARD_HOME_PUBLIC_KEY=
# [HOME] Keepalive in Sekunden, damit das NAT-Mapping am Heimrouter bestehen
# bleibt (Pflichtenheft §2.1).
WIREGUARD_KEEPALIVE=25


# -----------------------------------------------------------------------------
# 8. Agent auf dem Homeserver (Pflichtenheft §2.2 / §2.3)
# -----------------------------------------------------------------------------
# [BEIDE] Pre-Shared-Token, mit dem sich der Agent zusätzlich zur
# WireGuard-Verschlüsselung gegenüber dem Backend authentifiziert.
# Wird von scripts/setup.sh erzeugt und muss auf beiden Maschinen identisch sein.
AGENT_TOKEN=
# [HOME] WebSocket-Endpunkt des Backends, erreichbar über den Tunnel.
AGENT_BACKEND_WS_URL=ws://10.10.0.1:4000/agent
# [HOME] Docker-Socket-Proxy - der Agent spricht NIE direkt mit dem
# Docker-Socket (Pflichtenheft §2.3).
DOCKER_SOCKET_PROXY_URL=http://127.0.0.1:2375
# [HOME] Basisverzeichnis für Server-Datenordner in der Gameserver-VM.
AGENT_DATA_DIR=/srv/palantir/servers
# [HOME] Basisverzeichnis für Backups in der Gameserver-VM.
AGENT_BACKUP_DIR=/srv/palantir/backups
# [HOME] Optionales eigenes Seccomp-Profil für Gameserver-Container
# (Pflichtenheft §2.3). Pfad zu einer JSON-Datei AUF DEM HOMESERVER, die der
# Agent liest und bei jedem Container mitgibt. Bleibt die Variable leer, greift
# das Standard-Seccomp-Profil der Container-Engine - das ist die Vorgabe.
# "unconfined" ist an keiner Stelle vorgesehen.
AGENT_SECCOMP_PROFILE_PATH=


# -----------------------------------------------------------------------------
# 9. DNS-Automatisierung (Cloudflare, Pflichtenheft §13)
# -----------------------------------------------------------------------------
# [VPS] API-Token mit AUSSCHLIESSLICH DNS-Bearbeitungsrecht für die Zone.
CLOUDFLARE_API_TOKEN=
# [VPS] Zone-ID der Domain im Cloudflare-Dashboard.
CLOUDFLARE_ZONE_ID=


# -----------------------------------------------------------------------------
# 10. Benachrichtigungen (Pflichtenheft §14)
# -----------------------------------------------------------------------------
# [VPS] Standard-Discord-Webhook für Systemereignisse. Weitere Kanäle werden
# später über die Admin-Oberfläche gepflegt.
DISCORD_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# 11. Datei-Manager & Uploads (Lastenheft §3.3, Pflichtenheft §12.1)
# -----------------------------------------------------------------------------
# [VPS] Maximale Upload-Größe pro Datei in Bytes. Standard: 2 GB.
MAX_UPLOAD_SIZE_BYTES=2147483648


# -----------------------------------------------------------------------------
# 12. Game-Traffic-Proxy & Port-Pool (Pflichtenheft §2.4)
# -----------------------------------------------------------------------------
# [VPS] Öffentlicher Portbereich, aus dem Gameservern Ports zugewiesen werden.
GAME_PORT_RANGE_START=27000
GAME_PORT_RANGE_END=27999
# [VPS] Einzelner öffentlicher Port für das Hostname-Routing bei Spielen mit
# supportsVirtualHostRouting = true (initial Minecraft, via Infrared).
MINECRAFT_ROUTER_PORT=25565
