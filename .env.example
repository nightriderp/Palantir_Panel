# =============================================================================
# Palantir - zentrale Konfigurationsdatei (Vorlage)
# =============================================================================
# Pflichtenheft §12.1: Es gibt genau EINE .env im Repo-Root. Dieselbe Datei wird
# sowohl auf der VPS als auch auf dem Homeserver eingesetzt; jede Komponente
# liest nur die für sie relevanten Variablen.
#
# Erzeugen:             cp .env.example .env   (bzw. über scripts/setup.sh)
# Ablageort VPS:        /opt/palantir/.env
# Ablageort Homeserver: /opt/palantir/.env   (in der Gameserver-VM)
#
# SICHERHEITSAUFLAGE (Pflichtenheft §12.1):
#   chmod 600 .env  und Eigentümer auf den ausführenden Dienst-Nutzer setzen.
#   .env darf niemals ins Repository und nicht unverschlüsselt in automatische
#   System-Backups gelangen.
#
# Legende: [VPS] = wird auf der VPS gelesen, [HOME] = auf dem Homeserver,
#          [BEIDE] = auf beiden Maschinen.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Allgemein / Domain
# -----------------------------------------------------------------------------
# [BEIDE] development | production
NODE_ENV=production
# [BEIDE] fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# [VPS] Anzahl vertrauenswuerdiger Reverse-Proxy-Hops vor dem Backend.
# Bestimmt, welche X-Forwarded-For-Adresse als request.ip gilt – darauf keyt der
# Login-/Registrierungs-/2FA-Rate-Limit (Pflichtenheft §7). Genau der eigenen
# Proxy-Kette entsprechend setzen (1 = ein Reverse-Proxy vor dem Backend, §12.1;
# 0 = kein Proxy, direkte Verbindung). NICHT hochsetzen "zur Sicherheit": eine zu
# hohe Zahl liesse den Client den scheinbaren Ursprung faelschen.
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# EINZIGE STELLE, an der der Domainname gepflegt wird.
#
# Alle folgenden Adressen (Web, API, Cookie-Domain, OAuth-Redirects,
# Subdomain-Anzeige im Frontend) werden hieraus abgeleitet, solange sie nicht
# ausdrücklich gesetzt sind. Ein Domainwechsel ist damit EINE Änderung.
#
# Ableitungsregeln - Backend: apps/backend/src/config/env.ts (adressenAbleiten)
#                    Frontend: apps/frontend/next.config.mjs
# ---------------------------------------------------------------------------
# [VPS] Basis-Domain der Instanz. Gameserver-Subdomains entstehen hierunter
# (z. B. meinserver.<DOMAIN>).
PALANTIR_DOMAIN=example.tld

# Die folgenden Werte sind ABGELEITET und bleiben normalerweise leer.
# Nur setzen, wenn eine Adresse bewusst abweichen soll - typisch in der
# Entwicklung, wo Frontend und API auf localhost mit verschiedenen Ports liegen
# und sich nicht aus einer Domain ergeben.
#
# [VPS] Öffentliche Adresse des Frontends. Ohne Angabe: https://<PALANTIR_DOMAIN>
PUBLIC_WEB_URL=
# [VPS] Öffentliche Adresse der Backend-API. Ohne Angabe: https://api.<PALANTIR_DOMAIN>
PUBLIC_API_URL=
# [VPS] Öffentliche IPv4 der VPS - Ziel der DNS-Einträge für Spiele ohne
# Hostname-Routing.
VPS_PUBLIC_IP=203.0.113.10


# -----------------------------------------------------------------------------
# 2. Netzwerk-Bindings der Dienste
# -----------------------------------------------------------------------------
# [VPS] Backend-API (Fastify)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
# [VPS] Frontend (Next.js)
FRONTEND_PORT=3000
# [VPS] Adresse der Backend-API, wie sie der Browser sieht - nur NEXT_PUBLIC_-
# Variablen erreichen das Frontend im Browser (Next.js). Leer lassen ist der
# Normalfall: dann wird PUBLIC_API_URL uebernommen und ohne dieses
# https://api.<PALANTIR_DOMAIN> abgeleitet. Nur setzen, wenn die API fuer den
# Browser unter einer anderen Adresse erreichbar ist als fuer das Backend.
# ACHTUNG: Der Wert wird beim BAUEN des Frontend-Images eingesetzt, nicht zur
# Laufzeit - eine Aenderung wirkt erst nach einem Neubau (siehe docs/ci-cd.md).
NEXT_PUBLIC_API_URL=

# [VPS] Live-Kanal Browser <-> Backend (Pflichtenheft §5.3): Konsole, Live-Messwerte,
# Statuswechsel. Leer lassen, dann wird ws(s)://<NEXT_PUBLIC_API_URL>/live verwendet.
NEXT_PUBLIC_LIVE_WS_URL=
# [VPS] Basis-Domain für Server-Subdomains (Pflichtenheft §13) - derselbe Wert wie
# PALANTIR_DOMAIN. Der Wizard zeigt damit die entstehende Adresse an.
NEXT_PUBLIC_BASE_DOMAIN=


# -----------------------------------------------------------------------------
# 3. Datenbank (PostgreSQL, laeuft auf der VPS)
# -----------------------------------------------------------------------------
# [VPS] Vollständige Verbindungs-URL, die von Drizzle ORM genutzt wird.
DATABASE_URL=postgresql://palantir:CHANGE_ME@127.0.0.1:5432/palantir
# [VPS] Einzelwerte für den Datenbank-Container in docker-compose.
POSTGRES_USER=palantir
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=palantir


# -----------------------------------------------------------------------------
# 4. Sicherheit / Tokens (Pflichtenheft §7)
# -----------------------------------------------------------------------------
# [VPS] Signaturschlüssel für die kurzlebigen Access-Token (JWT).
# Wird von scripts/setup.sh automatisch erzeugt - niemals von Hand raten.
JWT_SECRET=
# [VPS] Lebensdauer des Access-Tokens.
JWT_ACCESS_TOKEN_TTL=15m
# [VPS] Lebensdauer des opaken Refresh-Tokens (gehasht in der Session-Tabelle).
REFRESH_TOKEN_TTL=30d
# [VPS] Lebensdauer des kurzlebigen Zwischen-Tokens zwischen erstem und zweitem
# Anmeldeschritt bei aktiver 2FA (Pflichtenheft §7). Er ersetzt nur die bereits
# geprueften Zugangsdaten, bis der Code eingegeben ist - deshalb kurz gehalten.
TWO_FACTOR_TOKEN_TTL=5m
# [VPS] Schlüssel für die CSRF-Token bei zustandsändernden Requests.
CSRF_SECRET=
# [VPS] Cookie-Domain für die httpOnly-Secure-Cookies.
# SameSite ist im Code fest auf "Lax" gesetzt (Pflichtenheft §7 - bewusst nicht
# "Strict", sonst bricht der OAuth-Rückkehr-Redirect).
COOKIE_DOMAIN=
# [VPS] Secure-Flag der Sitzungs-Cookies. Standard: true.
# NUR fuer lokale Entwicklung ohne TLS auf false setzen - ueber HTTP schickt der
# Browser ein Secure-Cookie sonst nie und der Login funktioniert dort nicht.
# Im Betrieb bleibt der Wert true.
COOKIE_SECURE=true

# [VPS] IP-basiertes Rate-Limiting auf Registrierung und Login
# (Pflichtenheft §7 und §18). Laenge des gleitenden Zeitfensters in Sekunden ...
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# ... und die zulaessige Anzahl Versuche je IP darin. Ein erfolgreicher Login
# setzt den Zaehler zurueck, damit einzelne Vertipper nicht aussperren.
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REGISTER_MAX=5


# -----------------------------------------------------------------------------
# 5. OAuth / OpenID-Provider (Pflichtenheft §7 - minimale Scopes)
# -----------------------------------------------------------------------------
# Mindestens ein Provider muss konfiguriert sein (Pflichtfeld-Prüfung im Setup).
# Redirect-URIs müssen in der jeweiligen Entwickler-Konsole exakt so eingetragen
# werden - Details in SETUP.md.

# [VPS] Discord - https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# [VPS] Twitch - https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

# [VPS] Steam (OpenID 2.0, kein Client-Secret - nur ein Web-API-Key)
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
STEAM_RETURN_URL=


# -----------------------------------------------------------------------------
# 6. ALTCHA (selbstgehostetes Proof-of-Work-CAPTCHA, Pflichtenheft §3)
# -----------------------------------------------------------------------------
# [VPS] HMAC-Schlüssel zur Signatur der ALTCHA-Challenges.
# Wird von scripts/setup.sh automatisch erzeugt.
ALTCHA_HMAC_KEY=
# [VPS] Schwierigkeitsgrad (obere Grenze der Zufallszahl). Höher = mehr
# Rechenaufwand für den Client.
ALTCHA_COMPLEXITY=100000
# [VPS] Gültigkeitsdauer einer Challenge in Sekunden.
ALTCHA_EXPIRY_SECONDS=300


# -----------------------------------------------------------------------------
# 7. WireGuard-Tunnel VPS <-> Homeserver (Pflichtenheft §2.1)
# -----------------------------------------------------------------------------
# Schlüsselpaare werden von scripts/setup.sh erzeugt. Der private Schlüssel
# einer Seite gehört ausschließlich auf die jeweilige Maschine.
# WireGuard-Konfigurationsdateien liegen unter:
#   VPS:        /etc/wireguard/wg0.conf
#   Homeserver: /etc/wireguard/wg0.conf  (in der Gameserver-VM)

# [BEIDE] Interne Tunnel-Adresse der VPS. Seit dem Spiele-Tunnel auch auf dem
# Homeserver nötig: `frpc` wählt damit zur VPS hinaus
# (`deploy/gamenode/frpc.toml`). Fehlt der Wert dort, bricht frpc beim Start mit
# einem Template-Fehler ab, statt still ohne Ziel zu laufen.
WIREGUARD_VPS_IP=10.10.0.1
# [HOME] Interne Tunnel-Adresse des Homeservers.
WIREGUARD_HOME_IP=10.10.0.2
# [VPS] Öffentlicher UDP-Port, auf dem WireGuard auf der VPS lauscht.
WIREGUARD_LISTEN_PORT=51820
# [VPS] Privater Schlüssel der VPS.
WIREGUARD_VPS_PRIVATE_KEY=
# [BEIDE] Öffentlicher Schlüssel der VPS (auf dem Homeserver als Peer nötig).
WIREGUARD_VPS_PUBLIC_KEY=
# [HOME] Privater Schlüssel des Homeservers.
WIREGUARD_HOME_PRIVATE_KEY=
# [BEIDE] Öffentlicher Schlüssel des Homeservers (auf der VPS als Peer nötig).
WIREGUARD_HOME_PUBLIC_KEY=
# [HOME] Keepalive in Sekunden, damit das NAT-Mapping am Heimrouter bestehen
# bleibt (Pflichtenheft §2.1).
WIREGUARD_KEEPALIVE=25


# -----------------------------------------------------------------------------
# 8. Agent auf dem Homeserver (Pflichtenheft §2.2 / §2.3)
# -----------------------------------------------------------------------------
# [BEIDE] Pre-Shared-Token, mit dem sich der Agent zusätzlich zur
# WireGuard-Verschlüsselung gegenüber dem Backend authentifiziert.
# Wird von scripts/setup.sh erzeugt und muss auf beiden Maschinen identisch sein.
#
# Das ist der Weg für genau einen Homeserver (Pflichtenheft §1, §2.1). Für
# MEHRERE Nodes bekommt jede ihr eigenes Token: einmalig über
# `POST /admin/nodes/:nodeId/agent-token` erzeugen (Berechtigung `node.manage`),
# die Antwort enthält es genau einmal im Klartext. Dieses Token trägt der Agent
# der jeweiligen Node hier ein - dann wird die Verbindung eindeutig dieser Node
# zugeordnet, und ein kompromittierter Agent betrifft nur seine eigene.
# Das gemeinsame Token unten bleibt als Rückfallweg gültig, solange für eine
# Node kein eigenes vergeben wurde.
AGENT_TOKEN=
# [HOME] Node, für die sich dieser Agent hält (UUID aus `GET /admin/nodes`).
# Optional. Ist sie gesetzt, prüft das Backend beim Verbindungsaufbau, dass sie
# zu der Node passt, der das Token gehört - passt sie nicht, wird die Verbindung
# abgelehnt (Close-Code 4401). Ohne Angabe entscheidet allein das Token.
# Bei mehreren Nodes empfohlen: Ein vertauschtes Token fällt so sofort auf,
# statt Befehle still an die falsche Node zu schicken.
AGENT_NODE_ID=
# [HOME] Registry, aus der die Spiel-Images geholt werden. Fehlt ein Image auf
# der Node, holt der Agent es beim Anlegen des Containers selbst.
# Oeffentliche Images (z. B. itzg/minecraft-server) brauchen keinen Zugang.
# Fuer die eigenen Images aus dem privaten GHCR-Repository dagegen schon:
# Benutzername und ein Personal Access Token (classic) mit read:packages.
# Der `docker login` auf der Node genuegt NICHT - der Agent spricht die
# Engine-API ueber den Socket-Proxy an, und die liest keine Client-Anmeldung.
# Beide Werte leer lassen, solange nur oeffentliche Images benutzt werden;
# ein halb gesetzter Zugang wird ignoriert.
AGENT_REGISTRY_SERVER=ghcr.io
AGENT_REGISTRY_USERNAME=
AGENT_REGISTRY_TOKEN=
# [HOME] WebSocket-Endpunkt des Backends, erreichbar über den Tunnel.
AGENT_BACKEND_WS_URL=ws://10.10.0.1:4000/agent
# [HOME] Docker-Socket-Proxy - der Agent spricht NIE direkt mit dem
# Docker-Socket (Pflichtenheft §2.3).
DOCKER_SOCKET_PROXY_URL=http://127.0.0.1:2375
# [HOME] Basisverzeichnis für Server-Datenordner in der Gameserver-VM.
AGENT_DATA_DIR=/srv/palantir/servers
# [HOME] Basisverzeichnis für Backups in der Gameserver-VM.
AGENT_BACKUP_DIR=/srv/palantir/backups
# [HOME] Optionales eigenes Seccomp-Profil für Gameserver-Container
# (Pflichtenheft §2.3). Pfad zu einer JSON-Datei AUF DEM HOMESERVER, die der
# Agent liest und bei jedem Container mitgibt. Bleibt die Variable leer, greift
# das Standard-Seccomp-Profil der Container-Engine - das ist die Vorgabe.
# "unconfined" ist an keiner Stelle vorgesehen.
AGENT_SECCOMP_PROFILE_PATH=
# [HOME] Abstand der periodischen Server-Abfrage in Sekunden (Pflichtenheft §9:
# "periodische Spielerabfrage durch den Agent"). Gilt nur, wenn das Backend im
# Befehl SET_SERVER_QUERY keinen eigenen Takt mitgibt. 60 Sekunden sind fein
# genug fuer den Auto-Shutdown und grob genug, dass die Abfrage den Spielserver
# nicht belastet.
AGENT_QUERY_INTERVAL_SECONDS=60
# [HOME] Frist einer einzelnen Server-Abfrage in Millisekunden. Laeuft sie ab,
# gilt der Server fuer diese Runde als nicht erreichbar - eine einzelne
# ausgefallene Abfrage schaltet nichts ab, das entscheidet das Backend.
AGENT_QUERY_TIMEOUT_MS=3000
# [HOME] Obergrenze eines Blocks beim Backup-Download in Byte (Lastenheft §3.3).
# Deckelt den vom Backend angeforderten maxBytes-Wert, damit eine zu grosse
# Anforderung den Agent nicht ueber den Speicher bringt. 8 MiB.
AGENT_DOWNLOAD_BLOCK_MAX_BYTES=8388608


# -----------------------------------------------------------------------------
# 9. DNS-Automatisierung (Cloudflare, Pflichtenheft §13)
# -----------------------------------------------------------------------------
# [VPS] API-Token mit AUSSCHLIESSLICH DNS-Bearbeitungsrecht für die Zone.
CLOUDFLARE_API_TOKEN=
# [VPS] Zone-ID der Domain im Cloudflare-Dashboard.
CLOUDFLARE_ZONE_ID=


# -----------------------------------------------------------------------------
# 10. Benachrichtigungen (Pflichtenheft §14)
# -----------------------------------------------------------------------------
# [VPS] Standard-Discord-Webhook für Systemereignisse. Weitere Kanäle werden
# über die Admin-Oberfläche gepflegt (Benachrichtigungskanäle).
#
# Kanäle ohne eigene Webhook-Adresse greifen auf diesen Wert zurück - so kommt
# der Standardkanal ohne ein Geheimnis in der Datenbank aus. Bleibt der Wert
# leer, laufen Backend und Panel unverändert; solche Kanäle sind dann nur nicht
# versandfähig und werden beim Auslösen übersprungen. Die Benachrichtigungen im
# Panel selbst (Inbox) hängen NICHT an diesem Wert.
#
# Format: https://discord.com/api/webhooks/<id>/<token>
# Anlegen in Discord: Servereinstellungen > Integrationen > Webhooks.
DISCORD_WEBHOOK_URL=

# [VPS] Frist für einen einzelnen Versandversuch an einen externen Kanal, in
# Millisekunden. Der Versand läuft im Hintergrund und hält den auslösenden
# Vorgang (Serverstart, Backup) nie auf; die Frist begrenzt nur, wie lange ein
# hängender Aufruf Verbindungen und Speicher belegt. Standard: 10 Sekunden.
NOTIFICATION_DELIVERY_TIMEOUT_MS=10000


# -----------------------------------------------------------------------------
# 11. Datei-Manager & Uploads (Lastenheft §3.3, Pflichtenheft §12.1)
# -----------------------------------------------------------------------------
# [VPS] Aufbewahrungsfrist des Messwert-Verlaufs in Stunden (Verlaufsdarstellung
# im Reiter „Übersicht"). Ältere Stichproben räumt der Zeitgeber weg.
# Standard: 48 Stunden.
STATS_HISTORY_RETENTION_HOURS=48

# [VPS] Maximale Upload-Größe pro Datei in Bytes. Standard: 2 GB.
MAX_UPLOAD_SIZE_BYTES=2147483648

# [VPS] Maximale Größe eines Weltdaten-Archivs beim Anlegen eines Servers
# (Lastenheft §3.3, „Migration von anderen Hosting-Anbietern"). Eigene Grenze,
# weil das Archiv auf dem Homeserver entpackt und dabei im Speicher gehalten
# wird. Es geht blockweise an den Agent, hängt also nicht mehr an dessen
# Kanal-Grenze von 64 MiB. Standard: 256 MiB.
MAX_WORLD_ARCHIVE_BYTES=268435456

# [VPS] Verzeichnis, in dem hochgeladene Weltdaten-Archive auf das Anlegen des
# Servers warten (Frist: 2 Stunden, danach räumt der nächste Upload sie weg).
# Ohne Angabe ein Unterordner des System-Temp-Verzeichnisses.
# WORLD_ARCHIVE_DIR=/var/lib/palantir/world-archives


# -----------------------------------------------------------------------------
# 12. Game-Traffic-Proxy & Port-Pool (Pflichtenheft §2.4)
# -----------------------------------------------------------------------------
# [BEIDE] Öffentlicher Portbereich, aus dem Gameservern Ports zugewiesen werden.
#
# Diese zwei Werte sind die EINZIGE Quelle für drei Dinge, die zusammenpassen
# müssen: die Portvergabe des Panels, die Erlaubnisliste von frps auf der VPS
# und die Proxy-Liste von frpc auf dem Homeserver. Laufen sie auseinander,
# bekommt ein Server einen Port, für den es keinen Tunnel gibt - er startet
# normal, meldet „läuft" und ist trotzdem nicht erreichbar. Deshalb lesen alle
# drei Stellen dieselben Variablen (deploy/vps/frps.toml,
# deploy/gamenode/frpc.toml).
#
# Der Bereich endet bei 25564 und nicht bei 25999, damit MINECRAFT_ROUTER_PORT
# (25565, siehe unten) nicht aus dem Pool vergeben werden kann. Wäre er im
# Pool, könnte ein Server ihn belegen, bevor das Hostname-Routing gebaut ist -
# und ihn später herauszulösen hieße, einem laufenden Server die Adresse zu
# nehmen. 25566-25999 bleibt als Reserve frei.
#
# Kosten eines großen Bereichs, auf dieser VPS gemessen: 1000 Ports (also 2000
# Proxies, je TCP und UDP) melden sich in rund einer Sekunde an; frps braucht
# dafür etwa 59 MB und 2009 Dateideskriptoren bei einer Grenze von über einer
# Million. Begrenzend sind nicht die Ressourcen, sondern die Angriffsfläche:
# jeder Port des Bereichs ist ein öffentlich erreichbarer Socket, auch wenn
# kein Server dahintersteht. Ändern kostet nur einen Neustart von frps und frpc.
GAME_PORT_RANGE_START=25000
GAME_PORT_RANGE_END=25564
# [VPS] Einzelner öffentlicher Port für das Hostname-Routing bei Spielen mit
# supportsVirtualHostRouting = true (initial Minecraft, via Infrared).
# Muss AUSSERHALB des Bereichs oben liegen. 25565 ist der Port, den der
# Minecraft-Client von sich aus verwendet - deshalb ist er nicht frei wählbar,
# ohne dass Spieler ihn eintippen müssten.
MINECRAFT_ROUTER_PORT=25565

# [BEIDE] Fassung von frp, die für beide Seiten des Spiele-Tunnels gezogen wird
# (Images `fatedier/frps` und `fatedier/frpc` des frp-Projekts). Ohne Vorgabe:
# ein fehlender Wert soll den Start abbrechen, statt still `:latest` zu ziehen.
FRP_VERSION=v0.70.0
# [BEIDE] Port des Steuerkanals zwischen frpc (Homeserver) und frps (VPS).
# frps lauscht damit ausschließlich auf WIREGUARD_VPS_IP, also nur im Tunnel -
# nie auf dem öffentlichen Interface.
FRP_BIND_PORT=7000
# [BEIDE] Gemeinsames Geheimnis der beiden Tunnel-Enden. Zweite Schranke neben
# dem WireGuard-Tunnel: ohne diesen Wert nimmt frps keinen Client an. Muss auf
# VPS und Homeserver identisch sein. Erzeugen z. B. mit
# `openssl rand -base64 32`.
FRP_TOKEN=CHANGE_ME
# [VPS] / [HOME] Speichergrenzen der beiden Tunnel-Dienste. Die Vorgaben
# reichen für den vollen Portbereich; gemessen wurden 59 MB (frps) und 46 MB
# (frpc) bei 2000 Proxies.
# FRPS_MEM_LIMIT=256m
# FRPC_MEM_LIMIT=256m


# -----------------------------------------------------------------------------
# 13. Ressourcen-Warnungen (Pflichtenheft §10)
# -----------------------------------------------------------------------------
# Schwellwerte, ab denen das Event resource.low ausgeloest wird (Konsument ist
# die Notification-Engine). Angabe in Prozent, gueltig sind 1 bis 100.
#
# Die HARTE Kapazitaetspruefung vor jedem Serverstart haengt NICHT an diesen
# Werten - sie misst immer gegen die vollen Ressourcen der Node. Hier geht es
# ausschliesslich um die Vorwarnung.
#
# Die Gesamt-Ressourcen der Node selbst stehen bewusst NICHT in dieser Datei,
# sondern als Datensatz an der Entitaet HostNode (Tabelle host_nodes) - eine
# zweite Node hat andere Werte als die aus Lastenheft §5.
#
# [VPS] Auslastung der Gameserver-VM, ab der gewarnt wird.
RESOURCE_WARN_NODE_PERCENT=85
# [VPS] Verbrauch eines einzelnen Servers gegen sein EIGENES Limit, ab dem
# gewarnt wird. Hoeher angesetzt als der Node-Wert: ein einzelner Server nahe
# an seinem RAM-Limit ist kurz vor dem Absturz, eine gut gefuellte Node nicht.
RESOURCE_WARN_SERVER_PERCENT=90


# -----------------------------------------------------------------------------
# 14. Audit-Log-Archivierung (Pflichtenheft §6)
# -----------------------------------------------------------------------------
# [VPS] Ablageort der komprimierten Archivdateien des Audit-Logs.
# Der Archivierungslauf (Admin-Oberflaeche oder
# "pnpm --filter @palantir/backend audit:archive") exportiert Eintraege, die
# aelter als 24 Monate sind, in dieses Verzeichnis und entfernt sie erst danach
# aus der aktiven Tabelle. Schlaegt der Export fehl, bleibt die Tabelle
# unveraendert.
# Ist die Variable leer, lehnt der Lauf ab - ein unklarer Ablageort fuer
# Sicherheitsprotokolle waere schlechter als gar keine Archivierung.
# Das Verzeichnis gehoert AUF DIE VPS und sollte in die Systemsicherung,
# aber restriktiv berechtigt sein (nur der Dienst-Nutzer).
AUDIT_ARCHIVE_DIR=/opt/palantir/data/audit-archive
# 15. Server-Orchestrierung (Pflichtenheft §9, §11)
# -----------------------------------------------------------------------------
# [VPS] Frist in Millisekunden, in der der Agent einen Befehl beantwortet haben
# muss. Danach meldet das Backend AGENT_COMMAND_TIMEOUT. Grosszuegig genug fuer
# ein CREATE samt Anlegen der Verzeichnisse, eng genug, dass ein haengender
# Homeserver keinen Request-Handler blockiert.
AGENT_COMMAND_TIMEOUT_MS=30000
# [VPS] Frist fuer das Anlegen eines Containers. Eigener Wert, weil der Agent
# ein fehlendes Image dabei selbst holt - bei einem Spiel-Image dauert das
# Minuten. Die Frist oben bleibt kurz und gilt fuer alle uebrigen Befehle.
AGENT_CREATE_TIMEOUT_MS=900000

# [VPS] Crash-Loop-Schutz (Pflichtenheft §9): So viele automatische Neustarts
# sind innerhalb des Zeitfensters erlaubt. Beim naechsten Absturz geht der
# Server auf "error" und es wird benachrichtigt, statt endlos neu zu starten.
CRASH_LOOP_MAX_RESTARTS=3
# [VPS] Laenge des gleitenden Zeitfensters in Minuten.
CRASH_LOOP_WINDOW_MINUTES=10

# [VPS] Health-Check nach dem Start (Pflichtenheft §9): Abstand zwischen zwei
# Versuchen in Millisekunden. Die Gesamtfrist bringt die Spiele-Definition mit
# (startupTimeoutSeconds) - ein Spiel, das seine Welt erst generieren muss,
# braucht laenger als der Test-Typ.
HEALTH_CHECK_INTERVAL_MS=3000
# [VPS] Frist eines einzelnen Verbindungsversuchs in Millisekunden.
HEALTH_CHECK_ATTEMPT_TIMEOUT_MS=3000

# [VPS] Vorgabewerte des automatischen Abschaltens fuer neu angelegte Server
# (Pflichtenheft §9). Pro Server aenderbar, etwa fuer ein geplantes Event.
# Inaktivitaets-Timeout in Minuten:
AUTO_SHUTDOWN_DEFAULT_IDLE_MINUTES=30
# Schonfrist nach jedem Serverstart in Minuten. Ein automatischer Neustart nach
# einem Absturz zaehlt dabei als regulaerer Start.
AUTO_SHUTDOWN_DEFAULT_GRACE_MINUTES=15

# [VPS] Takt des zentralen Zeitgebers in Millisekunden (apps/backend/src/
# scheduler.ts). Er stoesst zwei Ablaeufe an: den Auto-Shutdown-Sweep
# (Pflichtenheft §9) und die faelligen Backup-Zeitplaene (Lastenheft §3.3).
# Eine Minute, weil beide Faelligkeiten minutengenau sind: Ein Cron-Ausdruck
# loest fruehestens jede Minute aus, Inaktivitaets- und Schonfrist sind in
# Minuten konfiguriert. Groesser wuerde Cron-Minuten ueberspringen, kleiner
# brachte nichts. Dauert ein Durchlauf laenger als das Intervall, wird der
# naechste uebersprungen statt eingereiht.
SCHEDULER_INTERVAL_MS=60000

# [VPS] Hostname des Hostname-Routing-Proxys - Ziel der CNAME-Eintraege fuer
# Spiele mit supportsVirtualHostRouting (initial Minecraft via Infrared,
# Pflichtenheft §2.4 und §13). Bleibt die Variable leer, bekommt auch ein
# solches Spiel einen A-Eintrag auf VPS_PUBLIC_IP.
GAME_ROUTER_HOSTNAME=

# [VPS] Ausbaustufe der Installation (Lastenheft §3.5). Steuert, welche
# Spiele-Definitionen im Server-erstellen-Wizard auswaehlbar sind:
#   1 = nur der Test-Typ, 2 = zusaetzlich Minecraft, 3 = weitere Spiele.
INSTALLATION_PHASE=1



# -----------------------------------------------------------------------------
# 16. Deployment (docs/ci-cd.md)
# -----------------------------------------------------------------------------
# Diese Werte liest ausschliesslich docker-compose, nicht die Anwendung selbst.
# Die Fassungen haben bewusst KEINE Vorgabe in der Compose-Datei: fehlt ein
# Wert, bricht der Start ab, statt dass Docker stillschweigend :latest zieht -
# und niemand mehr weiss, welcher Stand eigentlich laeuft.

# [BEIDE] Fassung der Palantir-Images (Backend, Frontend, Agent) in GHCR.
# Im Betrieb steht hier "prod"; dieses Tag zeigt auf den freigegebenen Commit.
# Fuer einen gezielten Rueckfall stattdessen den vollstaendigen Commit-SHA
# eintragen - siehe docs/ci-cd.md Abschnitt 4.
PALANTIR_VERSION=prod

# [VPS] Fassung des Reverse Proxy.
TRAEFIK_VERSION=v3.7.8
# [VPS] Fassung der Datenbank. ACHTUNG beim Wechsel der Hauptversion: das
# Datenverzeichnis wird nicht automatisch migriert.
POSTGRES_VERSION=18
# [BEIDE] Fassung des Docker-Socket-Proxy (Pflichtenheft §2.3).
SOCKET_PROXY_VERSION=0.3.0

# [VPS] Adresse fuer die Let's-Encrypt-Registrierung. Dorthin gehen Hinweise auf
# ablaufende Zertifikate - eine erreichbare Adresse eintragen.
ACME_EMAIL=

# [BEIDE] Arbeitsspeicher-Obergrenzen der Container. Vorgaben stehen in den
# Compose-Dateien und passen auf eine VPS mit 4 GB; hier nur setzen, wenn davon
# abgewichen werden soll. Eine Grenze verhindert, dass ein einzelner Container
# den Host per OOM mitreisst.
TRAEFIK_MEM_LIMIT=
POSTGRES_MEM_LIMIT=
BACKEND_MEM_LIMIT=
FRONTEND_MEM_LIMIT=
MIGRATE_MEM_LIMIT=
AGENT_MEM_LIMIT=
SOCKET_PROXY_MEM_LIMIT=

# -----------------------------------------------------------------------------
# 17. Sicherungen des Panels (Mockup-Abgleich 12.5)
# -----------------------------------------------------------------------------
# [VPS] Ablageort der Abzuege der Panel-Datenbank.
#
# Gesichert wird die Datenbank des Panels - Konten, Rollen, Server-Datensaetze,
# Kontingente, Audit-Log. Die WELTDATEN der Gameserver sind das NICHT: Die
# liegen auf dem Homeserver und haben mit den Server-Backups einen eigenen Weg.
#
# Ist die Variable leer, gibt es keine Panel-Sicherung - weder von Hand noch
# geplant; die Oberflaeche meldet das benannt. Bewusst ohne Vorgabewert: Ein
# vollstaendiger Abzug in einem Verzeichnis, das niemand gewaehlt hat, waere
# schlechter als keine Sicherung.
#
# Das Verzeichnis gehoert AUF DIE VPS, sollte in die Systemsicherung gehen und
# restriktiv berechtigt sein (nur der Dienst-Nutzer): Der Abzug enthaelt jedes
# Konto und jedes Geheimnis der Instanz. Aus demselben Grund bietet das Panel
# ihn nicht zum Herunterladen an - es zeigt nur den Pfad.
#
# Im Docker-Betrieb steht hier der Pfad des HOSTS; die Compose-Datei haengt ihn
# unter /data/panel-backups in den Backend-Container ein und uebersteuert die
# Variable dort - genauso wie bei AUDIT_ARCHIVE_DIR. Das Verzeichnis muss dem
# Benutzer `node` (UID 1000) aus dem Image gehoeren, sonst scheitert pg_dump am
# Schreiben.
PANEL_BACKUP_DIR=/opt/palantir/data/panel-backups

# [VPS] Abstand zweier geplanter Sicherungen in Stunden. 0 schaltet den
# geplanten Lauf ab; von Hand bleibt er moeglich. Gerechnet wird der Abstand zum
# vorigen Lauf, nicht eine feste Uhrzeit - nach einem Neustart des Backends
# fehlte sonst genau der Lauf, dessen Uhrzeit in die Ausfallzeit fiel.
PANEL_BACKUP_INTERVAL_HOURS=24

# [VPS] Aufbewahrung in Tagen; 0 heisst „nie loeschen". Aeltere Abzuege raeumt
# der Zeitgeber samt Datei weg.
PANEL_BACKUP_RETENTION_DAYS=14

# [VPS] Nur noetig, wenn pg_dump nicht im PATH steht (z. B.
# /usr/lib/postgresql/18/bin/pg_dump). Die Fassung muss zur Datenbank passen:
# Ein aelteres pg_dump lehnt eine neuere Serverfassung ab. Im Docker-Betrieb
# leer lassen - das Backend-Image bringt postgresql-client-18 mit.
PG_DUMP_BINARY=


# -----------------------------------------------------------------------------
# Von der Pipeline gesetzt - NICHT von Hand eintragen
# -----------------------------------------------------------------------------
# PALANTIR_RELEASE ist die Version, die im Panel unten links steht. Sie wird
# NICHT hier gepflegt: Ein Deployment laeuft ausschliesslich ueber ein
# Versions-Tag `v*`, und deploy/vps/deploy.sh loest dieses Tag zum ausgerollten
# Commit auf und gibt es dem Frontend-Container mit. Wer den Stack von Hand
# startet, laesst den Wert weg - das Panel zeigt dann `Entwicklung`.
