<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Palantirs eigenes CounterStrikeSharp-Plugin (Betreiber 26.09.2026). Gebaut
    im Dockerfile (Stufe `uebung`), nicht im Repo. Die Fassung von
    CounterStrikeSharp.API muss zu CS2_CSS_VERSION im Dockerfile passen –
    start.test.mjs prüft das.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PalantirUebung</AssemblyName>
    <RootNamespace>PalantirUebung</RootNamespace>
    <!-- Keine Abhängigkeiten mit ausliefern: CounterStrikeSharp bringt die API selbst mit. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.374">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
