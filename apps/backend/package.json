{
  "name": "@palantir/backend",
  "version": "0.6.0",
  "private": true,
  "description": "Palantir Backend-API (Fastify, Node/TypeScript)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:owner": "tsx src/db/owner.ts",
    "db:check": "drizzle-kit check",
    "audit:archive": "tsx src/db/archive-audit.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src drizzle.config.ts",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed:prod": "node dist/db/seed.js",
    "db:owner:prod": "node dist/db/owner.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@palantir/contracts": "workspace:*",
    "@palantir/validation": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
