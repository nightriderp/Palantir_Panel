# Selbstaktualisierung der Gamenode - einmaliger Lauf, angestoßen vom Timer daneben.
#
# Ablageort auf dem Homeserver (in der Gameserver-VM):
#   /etc/systemd/system/palantir-update.service
#
# Einrichten:
#   sudo cp /opt/palantir/deploy/gamenode/palantir-update.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now palantir-update.timer

[Unit]
Description=Palantir Gamenode aktualisieren
Documentation=file:///opt/palantir/docs/ci-cd.md
# Ohne Netz und ohne Docker hat der Lauf keinen Zweck.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot

# Zugangsdaten liegen bewusst NICHT unter /root oder /home: `ProtectHome=true`
# weiter unten blendet beide Bäume für diesen Dienst aus. Ein `docker login` als
# root schreibt nach /root/.docker/config.json - der Dienst sähe die Datei nicht
# und der Pull des privaten Agent-Images scheiterte mit `unauthorized`. Deshalb
# zeigt DOCKER_CONFIG auf einen Pfad außerhalb, den ProtectHome nicht verdeckt.
#
# Der SSH-Deploy-Key für `git fetch` hat dasselbe Problem, wird aber anders
# gelöst: er steht als `core.sshCommand` in /opt/palantir/.git/config und
# braucht deshalb keine Umgebungsvariable. Beides ist in SETUP.md §3.4
# beschrieben.
Environment=DOCKER_CONFIG=/etc/palantir/docker
ExecStart=/opt/palantir/deploy/gamenode/update.sh

# Hängt der Lauf (Registry antwortet nicht), soll er abbrechen statt den Timer
# dauerhaft zu blockieren.
TimeoutStartSec=900

# Härtung. Das Skript braucht Docker, Git und Schreibrechte im Repo-Verzeichnis -
# sonst nichts.
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/palantir

StandardOutput=journal
StandardError=journal
